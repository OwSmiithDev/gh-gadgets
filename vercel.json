{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/donut"
    },
    {
      "source": "/stats",
      "destination": "/api/stats"
    },
    {
      "source": "/donut",
      "destination": "/api/donut"
