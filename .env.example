# Token classico do GitHub, sem nenhum escopo marcado.
# Sem escopo ele ja le tudo que e publico e, se vazar, nao da acesso a nada.
PAT_1=

# Opcional: tokens extras de outras contas elevam o teto de rate limit,
# que e de 5000 pontos/hora por token. O cliente faz rodizio automatico.
# PAT_2=
# PAT_3=

# Opcional: login padrao para scripts/render.js sem --user
# GH_USER=
